# Generated by `pnpm audio` (scripts/prepare-audio.mjs) from the source MP3; rebuilt on demand by the renderer.
audio/soundtrack.wav

# The licensed source track stays out of git (Mixkit allows use in videos, not redistribution of the file).
# Re-download it before rendering: see "Music" in README.md.
audio/*.mp3

# v2: generated mixes and the Mixkit sound effects (fetched by scripts/fetch-audio.mjs).
audio/*.wav
audio/sfx/
